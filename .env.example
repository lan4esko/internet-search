# Generate a private .env: python3 scripts/bootstrap.py --init-only
# This template deliberately has no usable password or connection URL.
COMPOSE_PROJECT_NAME=internet-search
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=28280
API_BIND_ADDRESS=127.0.0.1
API_PORT=28210

# Application
APP_ENV=production
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=internet_search
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Container telemetry. Proxy has an isolated network; the API has no Docker socket.
DOCKER_SOCKET_PATH=/var/run/docker.sock
METRICS_INTERVAL_SECONDS=5
METRICS_STALE_AFTER_SECONDS=20

# Shared artifact directory. Each TASK keeps its immutable source and raw
# Masscan/HTTPX chunk buffers below this path.
SCOPE_DATA_DIR=/data/scope

# Upper bounds for the real TASK runner. Per-TASK worker counts are stored in
# the isolated database and cannot exceed the capacity of this node.
MASSCAN_WORKERS=1
HTTPX_WORKERS=1
HTTPX_THREADS=500
HTTPX_TIMEOUT=5
HTTPX_RATE_LIMIT=50

# Optional Grafana/Prometheus profile. Set a private password before enabling it.
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=29090
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=23000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
