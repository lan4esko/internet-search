{
  "uid": "is-v2-containers",
  "title": "Internet Search 2 \u00b7 Containers",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "internet-search",
    "v2"
  ],
  "panels": [
    {
      "id": 1,
      "title": "CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "internet-search-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "RSS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "internet-search-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "container_memory_rss",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Network RX",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "internet-search-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "rate(container_network_receive_bytes_total[1m])",
          "refId": "A"
        }
      ]
    }
  ]
}
